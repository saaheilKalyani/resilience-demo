{
  "title": "Resilience Demo",
  "uid": "resilience-demo",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Order Service request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"order-service\", uri=\"/orders\"}[1m]))",
          "legendFormat": "POST /orders"
        }
      ]
    },
    {
      "id": 2,
      "title": "Payment Service request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"payment-service\", uri=~\"/payments.*\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Order Service response duration (avg)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"order-service\", uri=\"/orders\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"order-service\", uri=\"/orders\"}[1m]))",
          "legendFormat": "avg duration"
        }
      ]
    },
    {
      "id": 4,
      "title": "Payment Service response duration (avg)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"payment-service\", uri=~\"/payments.*\"}[1m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"payment-service\", uri=~\"/payments.*\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Order fallback count",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "orders_fallback_total{job=\"order-service\"}",
          "legendFormat": "fallback total"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "orders_processed_total{job=\"order-service\"}",
          "legendFormat": "processed total"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "orders_successful_total{job=\"order-service\"}",
          "legendFormat": "successful total"
        }
      ]
    },
    {
      "id": 6,
      "title": "Circuit Breaker state / failure rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "resilience4j_circuitbreaker_state{name=\"paymentCircuitBreaker\"}",
          "legendFormat": "state={{state}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "resilience4j_circuitbreaker_failure_rate{name=\"paymentCircuitBreaker\"}",
          "legendFormat": "failure rate %"
        }
      ]
    }
  ]
}
